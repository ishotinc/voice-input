{
  "manifest_version": 3,
  "name": "VoiceInput Meet 自動録音",
  "version": "1.1.4",
  "description": "Meetで相手が入室したら録音を開始し、自分が退出したら停止します。",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "key": "",
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "action": {
    "default_title": "VoiceInput Meet：接続待ち"
  }
}
